{
  "name": "TerpelPoC",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "appium": "appium",
    "build:android:debug": "cd android && ./gradlew assembleDebug",
    "e2e:android": "wdio wdio.android.conf.js",
    "e2e:android:report": "wdio wdio.android.conf.js | tee reports/wdio-android.log && node scripts/generate-e2e-report-android.js",
    "e2e:ios": "wdio wdio.ios.conf.js",
    "build:ios:debug": "xcodebuild -workspace ios/TerpelPoC.xcworkspace -scheme TerpelPoC -configuration Debug -sdk iphonesimulator -derivedDataPath ios/build"
  },
  "dependencies": {
    "@d11/react-native-fast-image": "^8.9.2",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.1.4",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-keychain": "^10.0.0",
    "react-native-modal": "^13.0.1",
    "react-native-otp-verify": "^1.1.8",
    "react-native-safe-area-context": "^5.0.0",
    "react-native-screens": "^4.8.0",
    "react-native-vector-icons": "^10.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native-community/cli-platform-ios": "15.0.1",
    "@react-native/babel-preset": "0.76.9",
    "@react-native/eslint-config": "0.76.9",
    "@react-native/metro-config": "0.76.9",
    "@react-native/typescript-config": "0.76.9",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "^18.2.6",
    "@types/react-test-renderer": "^18.0.0",
    "@wdio/appium-service": "^9.20.1",
    "@wdio/cli": "^9.20.1",
    "@wdio/local-runner": "^9.20.1",
    "@wdio/mocha-framework": "^9.20.1",
    "@wdio/spec-reporter": "^9.20.0",
    "appium": "^2.11.0",
    "appium-uiautomator2-driver": "^2.31.4",
    "appium-xcuitest-driver": "^10.8.0",
    "babel-jest": "^29.6.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "18.3.1",
    "typescript": "5.0.4",
    "uuid": "8.3.2",
    "webdriverio": "^9.20.1"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "uuid": "8.3.2",
    "@appium/support": {
      "uuid": "8.3.2"
    },
    "appium-uiautomator2-driver": {
      "uuid": "8.3.2",
      "@appium/support": {
        "uuid": "8.3.2"
      }
    }
  }
}
